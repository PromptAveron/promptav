---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact — PromptAveron" description="Get in touch with PromptAveron.">
  <section class="container-shell py-16">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-4 font-display text-4xl font-black tracking-tight text-[var(--text)]">Support and partnership enquiries</h1>
    <div class="mt-6 rounded-[28px] border border-[var(--border)] bg-[var(--surface)] p-8 shadow-soft">
      <p class="text-[var(--muted)]">Reach out at hello@promptaveron.com for editorial submissions, API questions, and partnership requests.</p>
    </div>
  </section>
</BaseLayout>
