---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Collections — PromptAveron" description="Explore editorial collections and prompt bundles.">
  <section class="container-shell py-16">
    <p class="eyebrow">Curated collections</p>
    <h1 class="mt-3 font-display text-4xl font-black tracking-tight text-[var(--text)]">Curated collections</h1>
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {['Brand Stories', 'Portrait Editorials', 'Fantasy Worlds', 'Commercial Campaigns', 'Travel Moodboards', 'Social Campaigns'].map((collection) => (
        <div class="rounded-2xl border border-[var(--border)] bg-[var(--surface)] p-5 shadow-soft">
          <h2 class="font-display text-2xl font-bold text-[var(--text)]">{collection}</h2>
          <p class="mt-3 text-sm text-[var(--muted)]">A curated set of high-performing prompts designed to help a clear visual story stand out.</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
