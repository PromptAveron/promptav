---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — PromptAveron" description="Learn more about PromptAveron and the mission behind the library.">
  <section class="container-shell py-16">
    <p class="eyebrow">Our mission</p>
    <h1 class="mt-4 font-display text-4xl font-black tracking-tight text-[var(--text)]">Designed to help creators ship better visual ideas.</h1>
    <p class="mt-5 max-w-3xl text-lg text-[var(--muted)]">PromptAveron curates practical, premium AI image prompts for teams, marketers, artists, and creators looking for beautifully structured ways to explore visual storytelling.</p>
  </section>
</BaseLayout>
