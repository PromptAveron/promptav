---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Categories — PromptAveron" description="Browse AI prompt categories.">
  <section class="container-shell py-16">
    <p class="eyebrow">Library categories</p>
    <h1 class="mt-3 font-display text-4xl font-black tracking-tight text-[var(--text)]">Browse prompt categories</h1>
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {['AI Portraits', 'Realistic Photography', 'Cinematic Photography', 'Anime and Manga', 'Fantasy Art', 'Digital Illustration', 'Character Design', 'Product Photography', 'Fashion and Editorial', 'Social Media Content', 'Logos and Branding', 'Architecture and Interior Design'].map((category, index) => (
        <a href="/prompts" class="overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] shadow-soft">
          <img src="https://images.unsplash.com/photo-1493246507139-91e8fad9978e?auto=format&fit=crop&w=1200&q=80" alt={category} class="h-44 w-full object-cover" />
          <div class="p-5">
            <h2 class="font-display text-2xl font-bold text-[var(--text)]">{category}</h2>
            <p class="mt-2 text-sm text-[var(--muted)]">{(index + 1) * 12} prompt ideas</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
