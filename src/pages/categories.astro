---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedCategories } from '../lib/prompts';
import { getPublishedPrompts } from '../lib/prompts';

const [categories, prompts] = await Promise.all([
  getPublishedCategories(),
  getPublishedPrompts(),
]);
---

<BaseLayout title="Categories — PromptAveron" description="Browse AI prompt categories.">
  <section class="container-shell py-16">
    <p class="eyebrow">Library categories</p>
    <h1 class="mt-3 font-display text-4xl font-black tracking-tight text-[var(--text)]">Browse prompt categories</h1>
    <p class="mt-3 max-w-2xl text-[var(--muted)]">Explore prompts organized by the visual styles and subjects you want to create.</p>
    {categories.length > 0 ? (
      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {categories.map((category) => {
          const categoryPrompts = prompts.filter((prompt) => prompt.category === category.name);
          const image = category.imagePath || categoryPrompts.find((prompt) => prompt.imageUrl)?.imageUrl;
          return (
            <a href="/prompts" class="group overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--surface)] shadow-soft transition hover:-translate-y-1">
              {image
                ? <img src={image} alt={category.name} class="h-44 w-full object-cover" />
                : <div class="h-44 bg-[var(--surface-alt)]" aria-hidden="true"></div>}
              <div class="p-5">
                <h2 class="font-display text-2xl font-bold text-[var(--text)]">{category.name}</h2>
                <p class="mt-2 min-h-10 text-sm text-[var(--muted)]">{category.description || 'Explore creative prompts in this category.'}</p>
                <p class="mt-4 text-xs font-semibold text-[var(--primary)]">{categoryPrompts.length} {categoryPrompts.length === 1 ? 'prompt' : 'prompts'}</p>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="card-surface mt-8 p-10 text-center">
        <h2 class="font-display text-2xl font-bold text-[var(--text)]">Categories are on the way</h2>
        <p class="mt-2 text-[var(--muted)]">Browse the prompt library while categories are being added.</p>
        <a href="/prompts" class="btn-primary mt-5">Explore prompts</a>
      </div>
    )}
  </section>
</BaseLayout>
